{
  "hosting": [
    {
      "target": "astra",
      "public": "frontend/out",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "/api/**",
          "run": {
            "serviceId": "yell-ai-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "/r/**",
          "run": {
            "serviceId": "yell-ai-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "/webhook{,/**}",
          "run": {
            "serviceId": "yell-ai-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "/payment/**",
          "run": {
            "serviceId": "yell-ai-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "/health",
          "run": {
            "serviceId": "yell-ai-api",
            "region": "asia-south1"
          }
        }
      ]
    },
    {
      "target": "admin",
      "public": "frontend/out-admin",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "no-referrer"
            },
            {
              "key": "Cache-Control",
              "value": "no-store"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "run": {
            "serviceId": "yell-ai-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "/health",
          "run": {
            "serviceId": "yell-ai-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
